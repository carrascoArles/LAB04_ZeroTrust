# Copia este archivo como .env.local y completa los valores (salen de las salidas de la pila).
# .env.local no se sube al repositorio. Ninguno de estos valores es secreto, pero el dominio
# de Cognito contiene el número de cuenta: no lo muestres en capturas.
VITE_API_URL=https://<api-id>.execute-api.us-east-2.amazonaws.com/academic
VITE_COGNITO_DOMAIN=https://aqp-solidaria-academic-<cuenta>.auth.us-east-2.amazoncognito.com
VITE_USER_POOL_ID=us-east-2_<id>
VITE_CLIENT_ID=<user-pool-client-id>

# Opcional. Si no se define, la SPA usa <origen actual>/callback, así el mismo build sirve en
# CloudFront y en http://localhost:5173. Cognito solo acepta las URI registradas.
# VITE_REDIRECT_URI=https://<distribucion>.cloudfront.net/callback
